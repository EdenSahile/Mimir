{
  "name": "@mimir/db",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "generate": "prisma generate",
    "push": "dotenv -e ../../.env -- prisma db push",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "check": "dotenv -e ../../.env -- tsx check.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.19.0",
    "vitest": "^5.0.5"
  }
}
