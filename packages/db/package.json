    "check": "dotenv -e ../../.env -- tsx check.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0"
  }
}
