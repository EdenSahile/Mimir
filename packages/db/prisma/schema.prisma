generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------------------------------------------------------------------------
// Auth
// Les tables session, account et verification seront ajoutées par Better Auth.
// Le modèle User ci-dessous est celui de Mímir. Better Auth s'y connectera.
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          Profile?
  preferences      Preference[]
  goals            Goal[]
  projects         Project[]
  tasks            Task[]
  conversations    Conversation[]
  documents        Document[]
  userModules      UserModule[]
  userIntegrations UserIntegration[]
  memories         Memory[]
}

// ---------------------------------------------------------------------------
// Profil utilisateur
// Transposition de context/CONTEXT.md en données structurées.
// ---------------------------------------------------------------------------

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city               String?
  country            String?
  bio                String?
  currentRole        String?
  dominantProfile    String?  // student, employee, entrepreneur, freelance, mixed
  mainActivity       String?
  skills             Json?
  languages          Json?
  communicationStyle String?  // direct, detailed, mixed
  priorityDomain     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Préférences (clé-valeur par utilisateur, extensible par les modules)
// ---------------------------------------------------------------------------

model Preference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ---------------------------------------------------------------------------
// Objectifs
// Transposition de la section "Mes objectifs" de CONTEXT.md.
// ---------------------------------------------------------------------------

model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String    // short_term, long_term
  status      String    @default("active") // active, completed, paused, abandoned
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Projets
// Entités structurées pouvant contenir des documents et des intégrations.
// ---------------------------------------------------------------------------

model Project {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        String               @default("active") // active, paused, completed, archived
  stack         Json?
  urls          Json?
  githubRepoUrl String?
  goals         String?
  notes         String?
  documents     Document[]
  integrations  ProjectIntegration[]
  tasks         Task[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// ---------------------------------------------------------------------------
// Tâches
// ---------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      String    @default("todo") // todo, in_progress, done, cancelled
  priority    String?   // low, medium, high, urgent
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Documents
// Fichiers originaux stockés dans un stockage objet.
// Le contenu extrait est indexé dans DocumentChunk pour la recherche sémantique.
// ---------------------------------------------------------------------------

model Document {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title            String
  type             String          // cv, cover_letter, certification, linkedin_export, project_doc, other
  mimeType         String
  fileKey          String          // clé dans le stockage objet
  fileSize         Int
  originalFilename String
  parsedText       String?         // texte brut extrait (affichage, pas search)
  status           String          @default("uploaded") // uploaded, parsing, indexed, error
  chunks           DocumentChunk[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// La colonne embedding (vector) sera ajoutée par une migration SQL brute
// quand le fournisseur et la dimension seront choisis.
// Voir docs/decisions.md — DEC-003.
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  metadata   Json?    // {page, section, position}
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Conversations et messages
// Transposition de HISTORY.md + nouveau système de chat.
// ---------------------------------------------------------------------------

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user, assistant, system
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Mémoire
// Faits, préférences et observations que Mímir retient sur l'utilisateur.
// La colonne embedding sera ajoutée avec DocumentChunk (même migration).
// ---------------------------------------------------------------------------

model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  type      String   // fact, preference, event, insight
  source    String?  // conversation_id ou "manual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Modules
// ---------------------------------------------------------------------------

model Module {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  version     String       @default("1.0.0")
  isActive    Boolean      @default(true)
  config      Json?
  userModules UserModule[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model UserModule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
}

// ---------------------------------------------------------------------------
// Intégrations
// ---------------------------------------------------------------------------

model Integration {
  id                  String               @id @default(cuid())
  name                String               @unique // github, google, notion, etc.
  description         String?
  config              Json?
  userIntegrations    UserIntegration[]
  projectIntegrations ProjectIntegration[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model UserIntegration {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId  String
  integration    Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  config         Json?
  status         String      @default("connected") // connected, expired, revoked
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([userId, integrationId])
}

model ProjectIntegration {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String?
  config        Json?
  lastSyncedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([projectId, integrationId])
}
