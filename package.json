{
  "name": "mimir",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run --parallel dev:api dev:web",
    "dev:api": "pnpm --filter @mimir/api dev",
    "dev:web": "pnpm --filter @mimir/web dev",
    "build": "pnpm run --parallel build:api build:web",
    "build:api": "pnpm --filter @mimir/api build",
    "build:web": "pnpm --filter @mimir/web build",
    "db:generate": "pnpm --filter @mimir/db generate",
    "db:push": "pnpm --filter @mimir/db push",
    "db:migrate": "pnpm --filter @mimir/db migrate",
    "db:check": "pnpm --filter @mimir/db check",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "HEADED=1 playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mimir/db": "workspace:*",
    "@playwright/test": "^1.63.0",
    "dotenv": "^18.0.6",
    "dotenv-cli": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1"
  }
}
