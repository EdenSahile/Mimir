# Base de données (Neon)
# DATABASE_URL : connexion poolée (host en -pooler), utilisée par l'app.
#   pgbouncer=true : requis avec le pooler Neon pour éviter les collisions de prepared statements.
# DIRECT_URL : connexion directe, utilisée par les migrations Prisma.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/mimir?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/mimir?sslmode=require"

# Listes blanches des bases que les commandes destructives peuvent viser, en
# prefixes de host separes par des virgules. Une liste absente vaut refus, donc
# l'environnement de production ne doit porter ni l'une ni l'autre.
#   PRISMA_PUSH_ALLOWED_HOSTS  : pour prisma db push (local et test seulement)
#   PRISMA_RESET_ALLOWED_HOSTS : pour prisma migrate reset (bases jetables)
PRISMA_PUSH_ALLOWED_HOSTS="ep-xxx,ep-yyy"
PRISMA_RESET_ALLOWED_HOSTS="ep-xxx,ep-yyy,ep-zzz"

# API Claude
ANTHROPIC_API_KEY=""

# Serveur
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Auth (Better Auth)
BETTER_AUTH_SECRET=""

# Stockage objet (fournisseur à choisir, voir docs/decisions.md)
# STORAGE_PROVIDER="local"
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# Embeddings (fournisseur à choisir, voir docs/decisions.md)
# EMBEDDING_PROVIDER=""
# EMBEDDING_MODEL=""
# EMBEDDING_DIMENSION=""
# EMBEDDING_API_KEY=""
